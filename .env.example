# Railway: Postgres → reference this from the Alex-books service
DATABASE_URL=

# Google sign-in (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=
# The public URL of the app, e.g. https://alex-books-production.up.railway.app
NEXTAUTH_URL=

# Optional: enables the end-of-book "your thoughts" summary
ANTHROPIC_API_KEY=

# Optional: the Google email that sees the private welcome note
LOVE_NOTE_EMAIL=
